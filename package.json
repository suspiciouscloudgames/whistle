{
  "name": "whistle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --experimental-strip-types --test tests/engine.test.ts tests/environment.test.ts tests/symbols.test.ts tests/derivation.test.ts tests/game-audio.test.ts",
    "test:browser": "playwright test",
    "test:storage": "playwright test tests/browser/storage.spec.ts",
    "benchmark:editor": "node tests/performance/editor.mjs",
    "audio:build": "node scripts/build-audio.mjs",
    "dev:audio": "npm run dev",
    "test:audio": "npm run audio:build && playwright test tests/browser/audio.spec.ts tests/browser/game-audio.spec.ts",
    "pretest:browser": "npm run audio:build",
    "prebuild": "npm run audio:build",
    "predev": "npm run audio:build"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "webpd": "1.0.0-alpha.14"
  }
}
