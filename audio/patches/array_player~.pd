#N canvas 80 60 720 680 12;
#X text 20 10 array_player~: plays an array pair with phasor~ and loops. set <left> [<right>]: with one array both sides read it (starts from the beginning). rate <f>: speed (1 = normal \, 0.5 = half \, 2 = double \, pitch follows). Right outlet: bang each time it reaches the end.;
#X obj 20 70 inlet;
#X obj 20 100 route set rate;
#X obj 20 130 list;
#X obj 20 160 t l l l;
#X obj 260 190 list split 1;
#X obj 260 250 symbol;
#X obj 400 190 list split 1;
#X obj 400 220 route bang;
#X msg 400 280 set \$1;
#X obj 20 190 list split 1;
#X obj 20 220 t b s s;
#X msg 20 280 set \$1;
#X obj 120 280 array size;
#X obj 120 310 max 1;
#X obj 120 340 t b f f;
#X obj 220 400 / 1;
#X obj 120 370 t b b;
#X obj 220 370 samplerate~;
#X obj 220 430 t b f;
#X obj 220 490 *;
#X obj 470 130 f 1;
#X msg 120 460 0;
#X obj 20 490 phasor~;
#X obj 20 520 *~;
#X obj 20 550 tabread4~;
#X obj 160 550 tabread4~;
#X obj 320 520 rzero~ 1;
#X obj 320 550 *~ -1;
#X obj 320 580 threshold~ 0.5 0 0.1 0;
#X obj 20 620 outlet~;
#X obj 160 620 outlet~;
#X obj 320 620 outlet;
#X text 400 620 end (bang);
