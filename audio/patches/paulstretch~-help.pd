#N canvas 60 60 640 527 12;
#X text 20 10 paulstretch~ <array> <stretch> - stretch a sound about 10x (like Audacity's Paulstretch);
#X obj 20 60 bng 19 250 50 0 empty empty open_a_sound_file 24 10 0 12 #fcfcfc #000000 #000000;
#X obj 20 90 openpanel;
#X obj 20 200 soundfiler;
#X floatatom 20 230 9 0 0 1 samples - - 0;
#X obj 300 60 array define \$0-src;
#X floatatom 300 120 5 0 0 1 stretch - - 0;
#X msg 300 150 stretch \$1;
#X msg 400 150 pos 0;
#X obj 20 290 paulstretch~ \$0-src 10;
#X obj 20 330 *~ 1;
#X obj 120 330 *~ 1;
#X floatatom 220 290 5 0 0 1 volume - - 0;
#X obj 20 380 dac~;
#X obj 534 390 tgl 19 0 empty empty DSP 24 10 0 12 #fcfcfc #000000 #000000 0 1;
#X msg 534 420 \; pd dsp \$1;
#X text 20 440 messages: set <left> [<right>] | stretch <f> | pos <samples>. Loops. L reads the left array \, R the right one (one array: both read it \, random phases differ per side so it comes out wide).;
#X obj 20 115 t b a;
#X obj 20 140 pack \$0 s;
#X msg 20 170 read -resize \$2 \$1-src;
#X connect 1 0 2 0;
#X connect 2 0 17 0;
#X connect 3 0 4 0;
#X connect 6 0 7 0;
#X connect 7 0 9 0;
#X connect 8 0 9 0;
#X connect 9 0 10 0;
#X connect 9 1 11 0;
#X connect 10 0 13 0;
#X connect 11 0 13 1;
#X connect 12 0 10 1;
#X connect 12 0 11 1;
#X connect 14 0 15 0;
#X connect 17 0 18 0;
#X connect 17 1 18 1;
